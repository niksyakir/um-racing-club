# Supabase project credentials
# Get these from: Supabase Dashboard > Project Settings > API

# Public project URL (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon/publishable key (safe to expose client-side, respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only secret — bypasses RLS. Never prefix with NEXT_PUBLIC_,
# never commit the real value, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
